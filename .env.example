# ─── Database (Supabase Postgres) ────────────────────────────────
# Pooled connection (Supavisor, transaction mode) — used by the app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"
# Direct connection — used by `prisma migrate` ONLY. Migrations hang silently
# over the transaction pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# ─── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Access control ──────────────────────────────────────────────
# Signup is closed. Only these addresses may log in. Comma-separated.
ALLOWED_EMAILS="swapnil@sorvexai.com"

# Public origin. MUST match the environment: http://localhost:3000 locally,
# https://proposals.sorvexai.com in production.
#
# This is what client-facing share links and email links are built from, and
# those end up stored in client records and inboxes — wrong values are painful
# to correct after the fact.
#
# Every origin that signs in must ALSO be listed in Supabase -> Authentication
# -> URL Configuration -> Redirect URLs as <origin>/auth/callback. Supabase does
# not error on an unlisted redirect; it silently falls back to the Site URL.
APP_URL="http://localhost:3000"

# ─── AI ──────────────────────────────────────────────────────────
# "local-cli"     → shells out to Claude Code on this machine (your Max plan).
#                   Hard-gated to non-production; the app refuses to boot with
#                   this set when NODE_ENV=production.
# "anthropic-api" → standard API calls. This is what runs on Vercel.
# "disabled"      → AI drafting off; everything else works.
AI_PROVIDER="disabled"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ─── Feature flags ───────────────────────────────────────────────
ENABLE_SIGNUPS="false"
